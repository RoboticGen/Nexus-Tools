{
  "name": "@nexus-tools/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "RoboticGen Academy design system components, shared by the workspace apps. Source-only: consumers compile it through their own Tailwind/TypeScript pipeline.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@nexus-tools/esp32-uploader": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "@nexus-tools/monaco-editor": "workspace:*"
  },
  "devDependencies": {
    "@nexus-tools/eslint-config": "workspace:*",
    "@nexus-tools/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "react": "^19.2.8",
    "typescript": "~6.0.2",
    "next-auth": "^4.24.15",
    "@nexus-tools/auth": "workspace:*",
    "next": "^16.3.1",
    "blockly": "^13.2.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-auth": "^4.24.15",
    "next": "^16.0.0",
    "blockly": "^13.0.0"
  }
}
