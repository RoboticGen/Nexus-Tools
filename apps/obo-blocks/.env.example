# Copy to .env.local and fill in. KEYCLOAK_CLIENT_SECRET is required — the
# NextAuth route handler throws at build time without it.

# Keycloak / NextAuth (server-side)
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=
KEYCLOAK_URL=https://auth.roboticgen.co
KEYCLOAK_REALM=roboticgen
KEYCLOAK_CLIENT_ID=obo-nexus
KEYCLOAK_CLIENT_SECRET=

# Keycloak (client-side, inlined at build time)
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.roboticgen.co
NEXT_PUBLIC_KEYCLOAK_REALM=roboticgen
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=obo-nexus

# Guest access (server-side, read at startup). Unset or anything but "true"
# lets students use the tool without signing in; "true" puts every page
# behind Keycloak.
REQUIRE_LOGIN=false
